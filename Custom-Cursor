-- Função principal para aplicar o Cursor no PC, Mobile e nas UIs do Jogo
local function aplicarIdNoCrosshairMM2(id)
    local assetId = "rbxassetid://" .. id

    -- 1. Mudar o ponteiro real do Mouse (PC)
    mouse.Icon = assetId

    -- 2. Atualizar mira fixa no centro da tela (Mobile / Geral)
    mobileCrosshair.Image = assetId
    mobileCrosshair.Visible = true

    -- 3. Alterar elementos de UI existentes no jogo (MM2, CoreGui e PlayerGui)
    task.spawn(function()
        pcall(function()
            for _, v in pairs(coreGui:GetDescendants()) do
                if v:IsA("ImageLabel") or v:IsA("ImageButton") then
                    local nome = v.Name:lower()
                    if nome:find("crosshair") or nome:find("gun") or nome:find("mira") or nome:find("target") then
                        v.Image = assetId
                    end
                end
            end
            for _, v in pairs(player.PlayerGui:GetDescendants()) do
                if v:IsA("ImageLabel") or v:IsA("ImageButton") then
                    local nome = v.Name:lower()
                    if nome:find("crosshair") or nome:find("gun") or nome:find("mira") then
                        v.Image = assetId
                    end
                end
            end
        end)
    end)
end

applyShiftBtn.MouseButton1Click:Connect(function()
    if shiftInput.Text ~= "" then
        aplicarIdNoCrosshairMM2(shiftInput.Text)
        applyShiftBtn.Text = "Aplicado com Sucesso!"
        task.wait(0.8)
        applyShiftBtn.Text = "Aplicar ID Digitado"
    end
end)

